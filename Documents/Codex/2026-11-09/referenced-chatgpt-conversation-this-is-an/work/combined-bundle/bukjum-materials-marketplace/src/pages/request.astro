---
import Base from '../layouts/Base.astro';
import { products } from '../data.js';
import { contactInfo, formEndpoint, whatsappUrl } from '../site-config.js';
---
<Base title="Request a quotation | Bukjum Marketplace" description="Request a wholesale quotation for recycled PP, HDPE or PET flakes from Bukjum.">
  <section class="page-hero"><div class="container"><a class="back-link" href="/">← Marketplace catalogue</a><p class="eyebrow">BUYER ENQUIRY</p><h1>Tell us what<br /><em>your operation needs.</em></h1><p>Share your material, quantity and delivery location. Bukjum will confirm price and availability in a quotation.</p></div></section>
  <section class="section"><div class="container enquiry-grid"><div><p class="eyebrow">BEFORE YOU SUBMIT</p><h2>Important details<br /><em>up front.</em></h2><ul class="check-list"><li>Minimum order is 10 tonnes.</li><li>Displayed prices are indicative per tonne; final pricing is confirmed by quotation.</li><li>Flakes are bagged and unwashed. Buyers should carry out additional cleaning.</li><li>Delivery is available within Nigeria, subject to confirmation for your location.</li><li>Exact particle sizes and PET/HDPE production split are not yet confirmed.</li></ul><div class="buyer-note"><strong>Current buyer relationships</strong><p>The founding supplier reports existing Chinese buyers in Lagos and Ogun States.</p></div></div>
  <div class="form-card"><h2>Request a quotation</h2><p>Include your planned quantity and destination for a useful response.</p>{formEndpoint ? <form action={formEndpoint} method="POST"><input type="hidden" name="_subject" value="Bukjum Marketplace quotation request" /><label>Name<input name="name" autocomplete="name" required /></label><label>Business email<input name="email" type="email" autocomplete="email" required /></label><label>Company<input name="company" autocomplete="organization" /></label><div class="form-row"><label>Material<select id="material" name="material" required><option value="">Choose material</option>{products.map((p) => <option value={p.slug}>{p.name}</option>)}<option value="multiple">More than one</option></select></label><label>Quantity (tonnes)<input name="quantity_tonnes" type="number" min="10" step="1" placeholder="10 or more" required /></label></div><label>Delivery location<input name="delivery_location" placeholder="City / State, Nigeria" required /></label><label>Intended use / requirements<textarea name="requirements" rows="4" placeholder="Intended application, timing, or other requirements"></textarea></label><label class="consent"><input type="checkbox" name="acknowledged_unwashed" value="yes" required /><span>I understand the flakes are unwashed and require additional cleaning.</span></label><button class="button button-primary" type="submit">Send quotation request <span>↗</span></button><small>Submission is handled by the configured Formspree endpoint. Prices and availability remain subject to confirmation.</small></form> : <div class="form-pending"><strong>Online quotation form is not configured yet</strong><p>Confirm the Formspree endpoint and the email that should receive enquiries. Until then, no online submission is enabled.</p>{whatsappUrl ? <a href={whatsappUrl} target="_blank" rel="noopener noreferrer">Ask on WhatsApp ↗</a> : <small>WhatsApp number and Bukjum contact details are pending confirmation.</small>}</div>}</div></div></section>
  <script>
    const material = new URLSearchParams(window.location.search).get('material');
    const select = document.querySelector<HTMLSelectElement>('#material');
    if (material && select && [...select.options].some((option) => option.value === material)) select.value = material;
  </script>
</Base>

