---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
const { title = 'Bukjum | Recycled plastic materials', description = 'Wholesale recycled plastic flakes in Nigeria. Request a quotation for PP, HDPE and PET.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} /><meta name="theme-color" content="#123e35" />
    <title>{title}</title>
  </head>
  <body><Header /><main><slot /></main><Footer /></body>
</html>
