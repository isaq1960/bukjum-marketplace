---
import '../styles/global.css';

const {
  title = "Bukjum Materials Marketplace | Recycling Aggregator & Processor in Nigeria & Africa",
  description = "Bukjum Nig. Ltd buys, sells, and processes recycling materials—including plastics (PET, HDPE, PP), paper, glass, and iron—linking buyers and sellers across Osun State, Nigeria, and Africa."
} = Astro.props;

const marketplaceSchema = {
  "@context": "https://schema.org",
  "@type": ["RecyclingCenter", "WholesaleStore", "LocalBusiness"],
  "name": "Bukjum Materials Marketplace",
  "legalName": "Bukjum Nig. Ltd",
  "url": "https://materials.bukjum.com",
  "logo": "https://materials.bukjum.com/favicon.svg",
  "description": description,
  "telephone": "+2348064791798",
  "email": "info@bukjum.com",
  "parentOrganization": {
    "@type": "Organization",
    "name": "Bukjum Recycling Center",
    "url": "https://bukjum.com"
  },
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "No 1, Oke Awon Street, Ede Road, Egbedi",
    "addressLocality": "Osogbo",
    "addressRegion": "Osun State",
    "addressCountry": "NG"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 7.7565,
    "longitude": 4.4962
  },
  "areaServed": [
    { "@type": "City", "name": "Osogbo" },
    { "@type": "State", "name": "Osun State" },
    { "@type": "Country", "name": "Nigeria" },
    { "@type": "Continent", "name": "Africa" }
  ],
  "sameAs": [
    "https://bukjum.com"
  ]
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://materials.bukjum.com').href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(marketplaceSchema)} />
</head>
<body class="bg-white text-gray-800 antialiased min-h-screen flex flex-col">
    <header class="bg-white border-b border-gray-200 sticky top-0 z-50 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
            <!-- Left side: Logo, Brand, and Recycling Centre Switcher -->
            <div class="flex items-center gap-4 sm:gap-6">
                <a href="https://materials.bukjum.com" class="flex items-center gap-3 text-gray-900 font-bold text-lg no-underline">
                    <div class="bg-green-600 text-white w-9 h-9 flex items-center justify-center rounded-lg">
                        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21c4.5-2.3 7-6 7-10.5C19 6.2 16.5 3 12 2 7.5 3 5 6.2 5 10.5 5 15 7.5 18.7 12 21Z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M12 20c-.3-5.2 1.4-9.2 5.1-12M12 14c-1.2-1.8-2.5-3-4.2-3.8"></path></svg>
                    </div>
                    <span>Bukjum Marketplace</span>
                </a>

                <!-- Vertical divider separator -->
                <span class="hidden h-6 w-px bg-gray-300 lg:block" aria-hidden="true"></span>

                <!-- Recycling Centre pill button next to logo -->
                <a 
                    href="https://bukjum.com" 
                    class="hidden items-center gap-2 rounded-xl border border-green-300 bg-green-50 px-4 py-2 text-lg font-bold text-green-900 no-underline shadow-xs transition hover:bg-green-600 hover:text-white hover:border-green-600 lg:inline-flex"
                >
                    <span>Recycling Centre</span>
                    <span aria-hidden="true">↗</span>
                </a>
            </div>

            <!-- Right side: Marketplace Nav Links -->
            <nav class="hidden md:flex items-center gap-6" aria-label="Main navigation">
                <a href="https://materials.bukjum.com" class="text-gray-600 hover:text-green-600 font-medium no-underline transition">Home</a>
                <a href="/products/" class="text-gray-600 hover:text-green-600 font-medium no-underline transition">Products</a>
                <a href="/buyers/" class="text-gray-600 hover:text-green-600 font-medium no-underline transition">For Buyers</a>
                <a href="/suppliers/" class="text-gray-600 hover:text-green-600 font-medium no-underline transition">For Suppliers</a>
                <a href="/contact/" class="text-gray-600 hover:text-green-600 font-medium no-underline transition">Contact</a>
            </nav>

            <!-- Mobile Dropdown Navigation -->
            <details class="md:hidden relative">
                <summary class="flex items-center gap-2 cursor-pointer select-none rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50" aria-label="Open the menu">
                    Menu
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16"></path></svg>
                </summary>
                <nav class="absolute right-0 top-full mt-3 w-64 rounded-2xl border border-gray-200 bg-white p-2 shadow-lg" aria-label="Mobile navigation">
                    <a href="https://bukjum.com" class="block rounded-lg bg-green-50 px-4 py-3 font-bold text-green-900 no-underline hover:bg-green-100">Recycling Centre ↗</a>
                    <a href="https://materials.bukjum.com" class="mt-1 block rounded-lg px-4 py-3 font-medium text-gray-700 no-underline hover:bg-gray-50">Home</a>
                    <a href="/products/" class="block rounded-lg px-4 py-3 font-medium text-gray-700 no-underline hover:bg-gray-50">Products</a>
                    <a href="/buyers/" class="block rounded-lg px-4 py-3 font-medium text-gray-700 no-underline hover:bg-gray-50">For Buyers</a>
                    <a href="/suppliers/" class="block rounded-lg px-4 py-3 font-medium text-gray-700 no-underline hover:bg-gray-50">For Suppliers</a>
                    <a href="/contact/" class="block rounded-lg px-4 py-3 font-medium text-gray-700 no-underline hover:bg-gray-50">Contact</a>
                </nav>
            </details>
        </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 flex-grow w-full">
        <slot />
    </main>

    <footer class="bg-gray-50 border-t border-gray-200 py-10 text-center text-gray-600 text-sm">
        <div class="max-w-7xl mx-auto px-4 space-y-2">
            <p class="font-semibold text-gray-800">© 2026 Bukjum Nig. Ltd. All rights reserved.</p>
            <p>Buying, selling, processing & aggregating recycling materials (plastics, paper, glass, and iron) across Osun State, Nigeria, and Africa.</p>
            <p><a href="https://bukjum.com" class="text-green-700 font-semibold hover:underline">Visit Bukjum Recycling Centre →</a></p>
            <p>Head Office: No 1, Oke Awon Street, Ede Road, Egbedi, Osun State, Nigeria | Tel/WhatsApp: <a href="tel:+2348064791798" class="text-green-700 hover:underline">+234 806 479 1798</a> | Email: <a href="mailto:info@bukjum.com" class="text-green-700 hover:underline">info@bukjum.com</a></p>
        </div>
    </footer>
</body>
</html>