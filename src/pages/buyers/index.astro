---
import BaseLayout from '../../layouts/Base.astro';
---
<BaseLayout title="Buyer enquiries & quotations | Bukjum" description="Contact Bukjum for a quotation for recycled PP, HDPE or PET flakes. Minimum order 10 tonnes.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">FOR INDUSTRIAL & WHOLESALE BUYERS</p>
      <h1>Let's find the right<br /><em>material for you.</em></h1>
      <p>Tell us your material, volume and destination. We'll confirm price and availability in a quotation.</p>
    </div>
  </section>
  <section class="section">
    <div class="container enquiry-grid">
      <div>
        <p class="eyebrow">BEFORE YOU ENQUIRE</p>
        <h2>Good to know<br /><em>up front.</em></h2>
        <ul class="check-list">
          <li>Minimum order is 10 tonnes.</li>
          <li>Indicative prices are per tonne; final pricing is confirmed by quotation.</li>
          <li>Flakes are bagged, unwashed and require additional cleaning by the buyer.</li>
          <li>Delivery is available within Nigeria. Share your destination for confirmation.</li>
          <li>Exact product sizes and PET/HDPE production split are not yet confirmed.</li>
        </ul>
        <div class="buyer-note"><strong>Already supplying buyers</strong><p>The founding supplier currently serves Chinese firms in Lagos and Ogun States.</p></div>
      </div>
      <div class="form-card buyer-contact-card">
        <h2>Request a quotation</h2>
        <p>Contact the Bukjum team with your material, quantity (minimum 10 tonnes), intended use and delivery location.</p>
        <dl class="supplier-contact-details">
          <div><dt>WhatsApp</dt><dd><a href="https://wa.me/2348064791798?text=Hello%20Bukjum%2C%20I%20would%20like%20a%20quotation%20for%20recycled%20plastic%20flakes." target="_blank" rel="noopener noreferrer">+2348064791798</a></dd></div>
          <div><dt>Phone</dt><dd><a href="tel:+2348064791798">+2348064791798</a><br /><a href="tel:+2348161105054">+2348161105054</a></dd></div>
          <div><dt>Email</dt><dd><a href="mailto:isaq1960@gmail.com">isaq1960@gmail.com</a></dd></div>
          <div><dt>Head office</dt><dd>No 1, Oke Awon Street, Ede Road, Egbedi, Osun State - Nigeria</dd></div>
        </dl>
        <a class="button button-primary" href="https://wa.me/2348064791798?text=Hello%20Bukjum%2C%20I%20would%20like%20a%20quotation%20for%20recycled%20plastic%20flakes." target="_blank" rel="noopener noreferrer">Request a quotation on WhatsApp <span>↗</span></a>
      </div>
    </div>
  </section>
</BaseLayout>