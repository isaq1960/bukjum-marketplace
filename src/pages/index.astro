---
import BaseLayout from '../layouts/Base.astro';

const activeCommodities = [
  { name: 'Plastics (PET, HDPE, PP)', spec: 'Baled & Flaked', status: 'In Stock', href: '/products/' },
  { name: 'Paper & Cardboard (OCC)', spec: 'Pressed Bales', status: 'Active Offtake', href: '/products/' },
  { name: 'Cullet & Glass', spec: 'Sorted Clear/Amber', status: 'In Stock', href: '/products/' },
  { name: 'Ferrous & Scrap Iron', spec: 'Heavy & Light Melt', status: 'Active Offtake', href: '/products/' },
];

const portals = [
  {
    title: 'For Industrial Buyers',
    tag: 'Bulk Procurement',
    description: 'Source processed and aggregated plastics (PET, HDPE, PP), paper, glass, and iron in bulk quantities (10+ tonnes) across Nigeria and Africa.',
    href: '/buyers/',
    cta: 'Enquire as a Buyer',
    icon: 'factory',
    cardBg: 'bg-sky-100/75 border-sky-200/80 hover:border-sky-300',
    iconBg: 'bg-sky-200/70 text-sky-900 ring-sky-300/60 group-hover:bg-sky-700 group-hover:text-white',
    tagBg: 'bg-white/80 text-sky-900',
    ctaColor: 'text-sky-900 decoration-sky-500 hover:text-sky-700',
  },
  {
    title: 'For Recycling Suppliers',
    tag: 'Direct Offtake',
    description: 'Sell collected plastics, paper, glass, and scrap iron directly to our Osun State processing hub or connect with verified industrial buyers.',
    href: '/suppliers/',
    cta: 'Supply Materials',
    icon: 'truck',
    cardBg: 'bg-purple-100/75 border-purple-200/80 hover:border-purple-300',
    iconBg: 'bg-purple-200/70 text-purple-900 ring-purple-300/60 group-hover:bg-purple-700 group-hover:text-white',
    tagBg: 'bg-white/80 text-purple-900',
    ctaColor: 'text-purple-900 decoration-purple-500 hover:text-purple-700',
  },
  {
    title: 'Material Processing & Aggregation',
    tag: 'Quality Assured',
    description: 'We sort, process, and aggregate recyclable commodities in Osun State to ensure reliable volume and consistent industrial quality.',
    href: '/products/',
    cta: 'View Material Catalogue',
    icon: 'layers',
    cardBg: 'bg-emerald-100/75 border-emerald-200/80 hover:border-emerald-300',
    iconBg: 'bg-emerald-200/70 text-emerald-900 ring-emerald-300/60 group-hover:bg-emerald-700 group-hover:text-white',
    tagBg: 'bg-white/80 text-emerald-900',
    ctaColor: 'text-emerald-900 decoration-emerald-500 hover:text-emerald-700',
  },
];
---

<BaseLayout
  title="Recycling Services & Materials Aggregator in Osun State | Bukjum"
  description="Bukjum buys, sells, and processes recycling materials—including plastics (PET, HDPE, PP), paper, glass, and iron—across Osogbo, Ede Road, and Osun State, Nigeria."
>
  <section class="py-6 sm:py-10">
    <div class="grid items-center gap-8 lg:grid-cols-12 lg:gap-10">
      <!-- Left Column: Core Value Proposition -->
      <div class="lg:col-span-7">
        <p class="text-xs font-extrabold uppercase tracking-wider text-emerald-700">
          RECYCLING AGGREGATOR & PROCESSOR — OSOGBO, OSUN STATE
        </p>
        <h1 class="mt-2.5 text-lg font-extrabold uppercase tracking-wide text-slate-900 sm:text-xl">
          Recycling services & materials <span class="text-emerald-700">processing in Osun State.</span>
        </h1>
        <p class="mt-4 text-base leading-relaxed text-slate-600 sm:text-lg">
          Welcome to <strong class="font-semibold text-slate-900">Bukjum</strong>—your premier recycling and sustainable waste management partner proudly serving <strong class="font-semibold text-slate-900">Osun State</strong>. Operating from our hub along Ede Road in Osogbo, we buy, process, and supply high-quality recyclable commodities—including plastics (PET, HDPE, PP), paper, glass, and iron—connecting verified buyers and sellers across Osun, Nigeria, and Africa.
        </p>
        <div class="mt-7 flex flex-wrap gap-4">
          <a
            href="/products/"
            class="inline-flex min-h-12 items-center justify-center rounded-full bg-emerald-600 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:bg-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
          >
            Browse Materials
          </a>
          <a
            href="/buyers/"
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-slate-300 bg-white px-6 py-3 text-sm font-bold text-slate-900 transition hover:border-emerald-600 hover:text-emerald-700 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600"
          >
            Request Quotation
          </a>
        </div>
      </div>

      <!-- Right Column: Functional Commodity Availability & Hub Card -->
      <aside class="lg:col-span-5" aria-label="Active commodities at Osogbo processing hub">
        <div class="rounded-3xl border border-slate-200 bg-slate-50/80 p-6 shadow-xs">
          <div class="flex items-center justify-between border-b border-slate-200 pb-3.5">
            <div>
              <p class="text-xs font-extrabold uppercase tracking-wider text-emerald-700">
                Active Commodities
              </p>
              <p class="text-xs text-slate-500 mt-0.5">Ede Road Hub, Osogbo • 10+ Tonne Lots</p>
            </div>
            <span class="inline-flex items-center gap-1.5 rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-bold text-emerald-800">
              <span class="size-1.5 rounded-full bg-emerald-600"></span>
              Trading Live
            </span>
          </div>

          <div class="mt-3.5 divide-y divide-slate-200/70">
            {activeCommodities.map((item) => (
              <a
                href={item.href}
                class="group flex items-center justify-between py-2.5 text-sm no-underline transition hover:bg-white/80 hover:px-2 hover:rounded-xl"
              >
                <div>
                  <span class="font-bold text-slate-900 group-hover:text-emerald-700">{item.name}</span>
                  <span class="block text-xs text-slate-500">{item.spec}</span>
                </div>
                <span class="rounded-full bg-white px-2.5 py-1 text-xs font-semibold text-slate-700 ring-1 ring-slate-200 group-hover:ring-emerald-300">
                  {item.status} →
                </span>
              </a>
            ))}
          </div>

          <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs text-slate-600">
            <span>Need custom volume specs?</span>
            <a href="/contact/" class="font-bold text-emerald-700 hover:underline">Contact Desk →</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="py-10 sm:py-14 border-t border-slate-100">
    <div class="mb-8">
      <h2 class="text-2xl font-extrabold tracking-tight text-slate-900 sm:text-3xl">
        Explore Marketplace Portals
      </h2>
      <p class="mt-2 text-slate-600">
        Select your role to buy, supply, or inspect processed recyclable commodities.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-3">
      {portals.map((portal) => (
        <article class={`group flex flex-col justify-between rounded-3xl border p-7 shadow-xs transition duration-200 hover:-translate-y-1 hover:shadow-md ${portal.cardBg}`}>
          <div>
            <div class="flex items-start justify-between gap-4">
              <span class={`grid size-12 shrink-0 place-items-center rounded-2xl ring-1 transition ${portal.iconBg}`} aria-hidden="true">
                {portal.icon === 'factory' && (
                  <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M5 21V7l7 4V7l7 4v10M9 17h1m4 0h1" />
                  </svg>
                )}
                {portal.icon === 'truck' && (
                  <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 7h11v10H3V7Zm11 3h4l3 3v4h-7v-7Z" />
                    <circle cx="7.5" cy="17.5" r="2" />
                    <circle cx="17.5" cy="17.5" r="2" />
                  </svg>
                )}
                {portal.icon === 'layers' && (
                  <svg viewBox="0 0 24 24" class="size-6" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m12 3 9 4.5-9 4.5-9-4.5L12 3Zm0 9 9 4.5-9 4.5-9-4.5L12 12Z" />
                  </svg>
                )}
              </span>

              <span class={`rounded-full px-3 py-1 text-xs font-semibold ${portal.tagBg}`}>
                {portal.tag}
              </span>
            </div>

            <h3 class="mt-6 text-xl font-extrabold tracking-tight text-slate-900">
              {portal.title}
            </h3>
            <p class="mt-3 text-sm leading-relaxed text-slate-700 sm:text-base">
              {portal.description}
            </p>
          </div>

          <div class="mt-6 pt-2">
            <a
              href={portal.href}
              class={`inline-flex items-center gap-1.5 text-sm font-bold underline decoration-2 underline-offset-4 transition ${portal.ctaColor}`}
            >
              <span>{portal.cta}</span>
              <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>