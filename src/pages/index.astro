---
import Base from '../layouts/Base.astro';
import { products } from '../data.js';
---
<Base title="Bukjum | Recycled plastic flakes, sourced in Nigeria" description="Explore indicative prices and request a quote for bagged PP, HDPE and PET flakes from a Nigerian supplier.">
  <section class="hero"><div class="container hero-grid"><div class="hero-copy"><p class="eyebrow"><span class="eyebrow-dot"></span> RECYCLED MATERIALS · NIGERIA</p><h1>Better connections<br />for <em>circular materials.</em></h1><p class="hero-lede">A practical link between recycled plastic suppliers and the businesses that use their materials.</p><div class="hero-actions"><a class="button button-primary" href="/products/">Explore materials <span>↗</span></a><a class="text-link" href="/buyers/">Talk to our team <span>→</span></a></div><div class="hero-proof"><span class="proof-icon">✳</span><span><strong>At least 50 tonnes / month</strong><small>Combined capacity across PET, HDPE and PP</small></span></div></div><div class="hero-visual"><img src="/images/recycling-sorting-illustrative.png" alt="Illustrative image of plastic recycling and sorting; not a photograph of Bukjum’s supplier facility or workers." /><div class="image-label"><span class="label-dot"></span> Recycling & sorting illustration</div><div class="visual-stamp"><span>LOCAL</span><strong>↗</strong><span>SUPPLY</span></div></div></div></section>
  <section class="statbar"><div class="container stat-grid"><div><strong>10 t</strong><span>Minimum order</span></div><div><strong>3</strong><span>Material types</span></div><div><strong>₦</strong><span>Indicative pricing shown</span></div><div><strong>Nigeria</strong><span>Delivery available nationwide</span></div></div></section>
  <section class="section"><div class="container"><div class="section-heading"><div><p class="eyebrow">MATERIALS AVAILABLE</p><h2>Choose a material.<br /><em>Start a conversation.</em></h2></div><a class="text-link" href="/products/">View all materials <span>→</span></a></div><div class="product-grid">{products.map((p, i) => <a class={`product-card ${p.color}`} href={`/products/${p.slug}/`}><div class="card-top"><span class="product-index">0{i + 1} / MATERIAL</span><span class="arrow-circle">↗</span></div><div class="flake-art" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div><h3>{p.name}</h3><p>{p.resin}</p><div class="card-bottom"><span class="price">{p.price}<small> / tonne · indicative</small></span><span class="card-arrow">→</span></div></a>)}</div><p class="price-note">Indicative price ranges only. Final price, availability and delivery details are confirmed in a quotation.</p></div></section>
  <section class="capacity-band"><div class="container capacity-inner"><div><p class="eyebrow eyebrow-light">FOUNDING SUPPLIER PROFILE</p><h2>Made for the realities<br />of bulk buying.</h2></div><div class="capacity-copy"><p>Continuous production with combined output of at least 50 tonnes per month across PP, HDPE and PET. PP accounts for approximately 90% of current production.</p><a class="button button-outline" href="/about/">How we work <span>↗</span></a></div><div class="capacity-number"><strong>50<span>+</span></strong><small>TONNES / MONTH<br />COMBINED CAPACITY</small></div></div></section>
  <section class="section process-section"><div class="container process-grid"><div><p class="eyebrow">STRAIGHTFORWARD, UP FRONT</p><h2>Know what arrives<br /><em>before you buy.</em></h2><p class="body-copy">Materials are collected, sorted and crushed, then sold in bags. They are not washed before crushing. Buyers should plan and budget for additional cleaning to meet their manufacturing requirements.</p><a class="text-link" href="/buyers/">See buyer information <span>→</span></a></div><div class="process-steps"><div><span>01</span><strong>Collected</strong><small>Post-consumer plastics sourced for processing.</small></div><div><span>02</span><strong>Sorted</strong><small>Materials separated by polymer type.</small></div><div><span>03</span><strong>Crushed & bagged</strong><small>Unwashed flakes. Additional cleaning by buyer.</small></div></div></div></section>
  <section class="section video-section"><div class="container video-grid"><div class="video-frame"><video controls playsinline preload="metadata" poster="/images/recycling-materials-poster.png" aria-label="Supplier-supplied video showing bags of material and the surrounding work area"><source src="/videos/recycling-materials.mp4" type="video/mp4" />Your browser does not support embedded video.</video></div><div class="video-copy"><p class="eyebrow">A LOOK AT THE MATERIALS</p><h2>From the work<br /><em>area to the buyer.</em></h2><p class="body-copy">Supplier-supplied footage showing bagged material and the surrounding work area. The video is provided for context and does not certify product specifications or cleanliness.</p><p class="price-note">Video: portrait, 360 × 640 · about 1 minute 35 seconds.</p></div></div></section>
  <section class="cta-section"><div class="container cta-inner"><div><p class="eyebrow eyebrow-light">READY TO SOURCE?</p><h2>Tell us what your<br />operation needs.</h2></div><a class="button button-light" href="/buyers/">Request a quotation <span>↗</span></a></div></section>
</Base>
