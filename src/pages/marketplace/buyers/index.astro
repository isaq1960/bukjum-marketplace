---
import Base from '../layouts/Base.astro';
---

<Base title="Recycled Materials Marketplace | Bukjum" description="Browse clean, recycled plastic materials and connect with trusted local suppliers in Nigeria.">
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">RECYCLED MATERIALS MARKETPLACE</p>
      <h1>Better connections for<br /><em>circular materials.</em></h1>
      <p>A practical link between recycled plastic suppliers and the businesses that use their materials.</p>
      
      <div style="margin-top: 2rem; display: flex; gap: 1rem;">
        <a href="/marketplace/products" class="button button-primary">Browse Materials</a>
        <a href="/marketplace/buyers" class="button button-secondary">Request Quotation</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Explore Marketplace Portals</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 1.5rem; margin-top: 1.5rem;">
        <div style="border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px;">
          <h3>For Industrial Buyers</h3>
          <p>Request quotations for bulk PET, HDPE, and PP flakes (10+ tonnes).</p>
          <a href="/marketplace/buyers">Enquire as a Buyer →</a>
        </div>
        <div style="border: 1px solid #ddd; padding: 1.5rem; border-radius: 8px;">
          <h3>For Plastic Suppliers</h3>
          <p>Supply collected plastic aggregates and partner with verified buyers.</p>
          <a href="/marketplace/suppliers">Supply Materials →</a>
        </div>
      </div>
    </div>
  </section>
</Base>