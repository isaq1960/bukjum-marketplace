---
import BaseLayout from '../../layouts/Base.astro';
import { products } from '../../data.js';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;

const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": `${product.name} — Bulk Recycled Commodity`,
  "description": `${product.summary} ${product.detail}`,
  "category": product.category,
  "brand": {
    "@type": "Brand",
    "name": "Bukjum Nig. Ltd"
  },
  "offers": {
    "@type": "AggregateOffer",
    "priceCurrency": "NGN",
    ...(product.priceLow ? { "lowPrice": product.priceLow, "highPrice": product.priceHigh } : {}),
    "availability": "https://schema.org/InStock",
    "seller": {
      "@type": "Organization",
      "name": "Bukjum Materials Marketplace",
      "url": "https://materials.bukjum.com"
    }
  }
};
---

<BaseLayout
  title={`Bulk ${product.name} Supplier in Osun State & Nigeria | Bukjum`}
  description={`${product.summary} Indicative price ${product.price}${product.priceLow ? ' per tonne' : ''}, 10-tonne minimum order from Osogbo, Osun State.`}
>
  <script type="application/ld+json" set:html={JSON.stringify(productSchema)} />

  <section class="page-hero product-hero">
    <div class="container">
      <a class="back-link" href="/products/">← All materials</a>
      <p class="eyebrow">{product.category}</p>
      <h1>{product.name}<br /><em>for bulk buyers.</em></h1>
      <p>{product.summary}</p>
    </div>
  </section>

  <section class="section">
    <div class="container detail-grid">
      <div>
        <p class="eyebrow">PRODUCT SPECIFICATIONS</p>
        <h2>Clear facts.<br /><em>Confirmed by quote.</em></h2>
        <p class="body-copy">{product.detail}</p>

        <div class="spec-list">
          <div>
            <span>Indicative price</span>
            <strong>{product.price}{product.priceLow ? ' / tonne' : ''}</strong>
          </div>
          <div>
            <span>Minimum order</span>
            <strong>{product.moq}</strong>
          </div>
          <div>
            <span>Preparation</span>
            <strong>{product.preparation}</strong>
          </div>
          <div>
            <span>Processing note</span>
            <strong>{product.processingNote}</strong>
          </div>
          <div>
            <span>Packaging</span>
            <strong>{product.packaging}</strong>
          </div>
          <div>
            <span>Dispatch & Delivery</span>
            <strong>Ex-works Osogbo or delivered across Nigeria</strong>
          </div>
        </div>
      </div>

      <aside class="quote-card">
        <span class="quote-mark">“</span>
        <h3>Check fit, price<br />and availability.</h3>
        <p>Share your required tonnage, delivery location, and intended industrial application. Bukjum will confirm availability in a formal quotation.</p>
        <a class="button button-primary" href={`/buyers/?material=${product.slug}`}>
          Request a quotation <span>↗</span>
        </a>
        <div style="margin-top: 12px;">
          <a href={`/suppliers/?material=${product.slug}`} style="font-size: 0.875rem; font-weight: 700; color: #047857; text-decoration: underline;">
            Have {product.name} to sell? Supply to Bukjum →
          </a>
        </div>
        <small style="display: block; margin-top: 12px;">10-tonne minimum order · Final price subject to confirmation</small>
      </aside>
    </div>
  </section>
</BaseLayout>