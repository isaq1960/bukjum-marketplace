---
import Base from '../../layouts/Base.astro';
import { products } from '../../data.js';
export function getStaticPaths() { return products.map((product) => ({ params: { slug: product.slug }, props: { product } })); }
const { product } = Astro.props;
---
<Base title={`${product.name} | Bukjum`} description={`${product.summary} Indicative price ${product.price} per tonne, subject to quotation.`}><section class="page-hero product-hero"><div class="container"><a class="back-link" href="/products/">← All materials</a><p class="eyebrow">{product.resin}</p><h1>{product.name}<br /><em>for bulk buyers.</em></h1><p>{product.summary}</p></div></section><section class="section"><div class="container detail-grid"><div><p class="eyebrow">PRODUCT DETAILS</p><h2>Clear facts.<br /><em>Confirmed by quote.</em></h2><p class="body-copy">{product.detail}</p><div class="spec-list"><div><span>Indicative price</span><strong>{product.price} / tonne</strong></div><div><span>Minimum order</span><strong>10 tonnes</strong></div><div><span>Preparation</span><strong>Collected, sorted, crushed</strong></div><div><span>Washing</span><strong>Unwashed; buyer cleaning required</strong></div><div><span>Packaging</span><strong>Sold in bags</strong></div><div><span>Delivery</span><strong>Available within Nigeria</strong></div></div></div><aside class="quote-card"><span class="quote-mark">“</span><h3>Check fit, price<br />and availability.</h3><p>Share your quantity, delivery location and intended application. Bukjum will confirm details in a quotation.</p><a class="button button-primary" href={`/buyers/?material=${product.slug}`}>Request a quotation <span>↗</span></a><small>10-tonne minimum order · Final price subject to confirmation</small></aside></div></section></Base>
