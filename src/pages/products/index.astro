
---
import BaseLayout from '../../layouts/Base.astro';
import { products } from '../../data.js';
---

<BaseLayout
  title="Recycled plastic materials | Bukjum"
  description="Indicative price ranges and product details for PP, HDPE and PET flakes."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">MATERIAL CATALOGUE</p>
      <h1>Recycled flakes,<br /><em>clearly described.</em></h1>
      <p>
        Indicative wholesale prices, with the processing details
        buyers need to make an informed enquiry.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="catalogue-grid">
        {products.map((p, i) => (
          <a
            href={`/products/${p.slug}/`}
            class={`catalogue-card ${p.color} catalogue-card-clickable`}
            aria-label={`View details for ${p.name}`}
          >
            <span class="product-index">0{i + 1} / MATERIAL</span>

            <div class="flake-art" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>

            <h2>{p.name}</h2>

            <p>{p.summary}</p>

            <p class="catalogue-price">
              {p.price}<small> / tonne</small>
            </p>

            <p class="tag-line">
              Unwashed · Bagged · 10-tonne minimum
            </p>

            <span class="button button-dark">
              Product details <span>↗</span>
            </span>
          </a>
        ))}
      </div>

      <div class="notice-box">
        <strong>Price and processing note</strong>
        <p>
          All prices are indicative per tonne and subject to
          confirmation by quotation. Material is not washed
          before crushing; buyers should carry out additional
          cleaning. Product sizes have not been confirmed.
        </p>
      </div>

    </div>
  </section>

  <style>
    .catalogue-card-clickable {
      display: block;
      text-decoration: none;
      color: inherit;
      cursor: pointer;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .catalogue-card-clickable:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.10);
    }

    .catalogue-card-clickable:focus-visible {
      outline: 3px solid #376b43;
      outline-offset: 4px;
    }

    .catalogue-card-clickable .button {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
  </style>

</BaseLayout>
