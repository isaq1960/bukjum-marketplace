---
import BaseLayout from '../../layouts/Base.astro';
import { products } from '../../data.js';
---

<BaseLayout
  title="Recyclable Materials Catalogue (Plastics, Paper, Glass & Iron) | Bukjum"
  description="Indicative wholesale prices and specifications for PP, HDPE, PET flakes, OCC cardboard bales, cullet glass, and scrap iron in Osun State and Nigeria."
>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">MATERIAL CATALOGUE</p>
      <h1>Recyclable commodities,<br /><em>clearly specified.</em></h1>
      <p>
        Wholesale specifications and indicative pricing from our Osogbo, Osun State processing hub, with the technical details buyers need to make an informed enquiry.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="catalogue-grid">
        {products.map((p, i) => (
          <a
            href={`/products/${p.slug}/`}
            class={`catalogue-card ${p.color} catalogue-card-link`}
            aria-label={`View ${p.name} product details`}
          >
            <span class="product-index">
              0{i + 1} / MATERIAL
            </span>

            <div class="flake-art" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
              <span></span>
            </div>

            <h2>{p.name}</h2>

            <p>{p.summary}</p>

            <p class="catalogue-price">
              {p.price}
              {p.priceLow && <small> / tonne</small>}
            </p>

            <p class="tag-line">
              {p.tagLine}
            </p>
          </a>
        ))}
      </div>

      <div class="notice-box">
        <strong>Price and processing note</strong>
        <p>
          All prices are indicative per tonne and subject to confirmation by quotation based on volume and delivery destination. Plastic flakes are supplied unwashed unless otherwise agreed; buyers should carry out additional cleaning to match plant specifications.
        </p>
      </div>
    </div>
  </section>

  <style>
    .catalogue-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      align-items: stretch;
      width: 100%;
    }

    .catalogue-card-link {
      display: flex;
      flex-direction: column;
      width: 100%;
      min-width: 0;
      height: 100%;
      box-sizing: border-box;
      text-decoration: none !important;
      color: inherit;
      cursor: pointer;
      transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .catalogue-card-link:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 28px rgba(0, 0, 0, 0.10);
    }

    .catalogue-card-link:focus-visible {
      outline: 3px solid #376b43;
      outline-offset: 4px;
    }

    .catalogue-card-link p {
      overflow-wrap: anywhere;
    }

    @media (max-width: 900px) {
      .catalogue-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    @media (max-width: 600px) {
      .catalogue-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>