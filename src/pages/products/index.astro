---
import BaseLayout from '../../layouts/Base.astro';
import { products } from '../../data.js';
---
<BaseLayout title="Recycled plastic materials | Bukjum" description="Indicative price ranges and product details for PP, HDPE and PET flakes."><section class="page-hero"><div class="container"><p class="eyebrow">MATERIAL CATALOGUE</p><h1>Recycled flakes,<br /><em>clearly described.</em></h1><p>Indicative wholesale prices, with the processing details buyers need to make an informed enquiry.</p></div></section><section class="section"><div class="container"><div class="catalogue-grid">{products.map((p, i) => <article class={`catalogue-card ${p.color}`}><span class="product-index">0{i + 1} / MATERIAL</span><div class="flake-art" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div><h2>{p.name}</h2><p>{p.summary}</p><p class="catalogue-price">{p.price}<small> / tonne</small></p><p class="tag-line">Unwashed · Bagged · 10-tonne minimum</p><a class="button button-dark" href={`/products/${p.slug}/`}>Product details <span>↗</span></a></article>)}</div><div class="notice-box"><strong>Price and processing note</strong><p>All prices are indicative per tonne and subject to confirmation by quotation. Material is not washed before crushing; buyers should carry out additional cleaning. Product sizes have not been confirmed.</p></div></div></section></BaseLayout>



