---
// src/pages/index.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Bukjum Platform</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body style="font-family: system-ui, sans-serif; text-align: center; padding: 4rem 1rem;">
    <h1>Welcome to Bukjum</h1>
    <p style="font-size: 1.2rem; color: #555;">Select a portal to continue:</p>

    <div style="display: flex; gap: 1.5rem; justify-content: center; margin-top: 2rem; flex-wrap: wrap;">
      <a 
        href="/recycling" 
        style="background: #2e7d32; color: white; padding: 1.5rem 2rem; text-decoration: none; border-radius: 8px; font-weight: bold; width: 220px;"
      >
        Recycling Center
        <span style="display: block; font-size: 0.85rem; font-weight: normal; margin-top: 0.5rem;">Intake, Locations & WhatsApp</span>
      </a>

      <a 
        href="/marketplace" 
        style="background: #1565c0; color: white; padding: 1.5rem 2rem; text-decoration: none; border-radius: 8px; font-weight: bold; width: 220px;"
      >
        Marketplace
        <span style="display: block; font-size: 0.85rem; font-weight: normal; margin-top: 0.5rem;">Browse & Buy Materials</span>
      </a>
    </div>
  </body>
</html>