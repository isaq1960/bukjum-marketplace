---
// src/pages/recycling/index.astro
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Bukjum Recycling Center</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
  </head>
  <body style="font-family: system-ui, sans-serif; max-width: 800px; margin: 0 auto; padding: 2rem;">
    <header style="margin-bottom: 2rem;">
      <a href="/">← Back to Main Hub</a>
      <h1>Bukjum Recycling Center</h1>
      <p>Official plastic intake, recycling operations, and eco-logistics.</p>
    </header>

    <main>
      <section style="background: #f4f4f4; padding: 1.5rem; border-radius: 8px; margin-bottom: 2rem;">
        <h2>Contact & Collection Info</h2>
        <p><strong>Physical Address:</strong> [Insert your exact physical address here]</p>
        <p><strong>Operating Hours:</strong> Monday – Saturday (8:00 AM – 5:00 PM)</p>
        
        <!-- Replace 2348000000000 with your actual WhatsApp phone number including country code -->
        <a 
          href="https://wa.me/2348000000000?text=Hello%20Bukjum%20Recycling,%20I%20have%20an%20inquiry" 
          target="_blank" 
          style="display: inline-block; background: #25D366; color: white; padding: 0.75rem 1.5rem; text-decoration: none; border-radius: 5px; font-weight: bold;"
        >
          Chat with us on WhatsApp
        </a>
      </section>

      <section>
        <h2>Materials We Accept</h2>
        <ul>
          <li>PET Plastic Bottles</li>
          <li>HDPE Containers & Drums</li>
          <li>Sorted Clean Aggregates</li>
        </ul>
      </section>
    </main>
  </body>
</html>